# FlipperPwn Module — WiFi Survey -> Auto HID Report
# Full wireless recon that auto-generates a formatted report on the target
# machine by typing scan results via USB HID. The Flipper IS the keyboard — no
# software installed on the target.
#
#   1. Scan APs
#   2. Scan stations (associated clients)
#   3. Sniff probe requests
#   4. Open a text editor on the target and type a formatted survey report
#
# Single `PLATFORM ALL` block (see evil_twin.fpwn) — OPEN_NOTEPAD is OS-aware, so
# the report lands in Notepad/TextEdit/gedit as appropriate. Marauder command
# names/flags vary by fork — adjust the WIFI_CMD lines to your ESP32 build.
#
# REQUIREMENTS:
#   - ESP32 WiFi Dev Board + WiFi Marauder
#   - AUTHORIZED TESTING ONLY

NAME        wifi_survey_report
DESCRIPTION Full wireless survey: scan APs + stations + probes, generate HID-typed report
CATEGORY    recon
PLATFORMS   WIN,MAC,LINUX

# Note: .fpwn OPTION default values are single tokens (no spaces); set a
# multi-word site/assessor name at run time via the on-device option editor.
OPTION SCAN_DURATION  12000  "AP scan duration in ms (longer = more APs)"
OPTION PROBE_DURATION 20000  "Probe sniff duration in ms"
OPTION SITE_NAME Target_Site "Site name for report header"
OPTION ASSESSOR  Assessor    "Assessor name for report header"

PLATFORM ALL
IF_CONNECTED
  # ── Phase 1: AP scan ────────────────────────────────────────────────────
  PRINT Phase 1: Scanning APs...
  LED_COLOR BLUE
  WIFI_SCAN
  WIFI_WAIT {{SCAN_DURATION}}

  # ── Phase 2: Station scan ───────────────────────────────────────────────
  PRINT Phase 2: Scanning stations...
  LED_COLOR CYAN
  WIFI_CMD scansta
  WIFI_WAIT 8000
  WIFI_STOP

  # ── Phase 3: Probe sniff ────────────────────────────────────────────────
  PRINT Phase 3: Sniffing probes...
  LED_COLOR MAGENTA
  WIFI_CMD sniffprobe
  WIFI_WAIT {{PROBE_DURATION}}
  WIFI_STOP

  # ── Phase 4: Open editor and type report ────────────────────────────────
  PRINT Phase 4: Typing report...
  LED_COLOR YELLOW
  OPEN_NOTEPAD
  DELAY 1500
  STRINGLN ================================================
  STRINGLN  WIRELESS SURVEY REPORT
  STRINGLN ================================================
  STRINGLN  Site:     {{SITE_NAME}}
  STRINGLN  Assessor: {{ASSESSOR}}
  STRINGLN  Tool:     Flipper Zero + WiFi Marauder (ESP32)
  STRINGLN
  STRINGLN -- ACCESS POINTS DISCOVERED --
  WIFI_RESULT
  STRINGLN
  STRINGLN -- ASSOCIATED STATIONS --
  WIFI_STA_RESULT
  STRINGLN
  STRINGLN -- ASSESSMENT NOTES --
  STRINGLN [ ] Open/unencrypted networks present?
  STRINGLN [ ] WPS enabled on any APs?
  STRINGLN [ ] Default SSIDs (NETGEAR-XX, xfinitywifi, etc.)?
  STRINGLN [ ] Rogue APs detected?
  STRINGLN [ ] Guest network isolation verified?
  STRINGLN ================================================
  STRINGLN END OF AUTOMATED SURVEY
  LED_COLOR GREEN
  PRINT Survey report complete
END_IF
